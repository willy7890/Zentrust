generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS
  INSTITUTION
}

model User {
  id        String   @id @default(cuid())
  auth0Id   String   @unique          
  email     String   @unique
  name      String?
  role      Role
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}