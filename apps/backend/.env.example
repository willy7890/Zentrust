# Environment variables for the backend – copy to .env and fill real values

APP_NAME=ZENTRUST
DATABASE_NAME=postgreql

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/zen_db
SECRET_KEY=your secret key
ALGORITHM=H256
EXPIRE_TOKEN_TIME=30

PORT=5000

# Badilisha hii na database yako halisi
DATABASE_URL="postgresql://username:password@localhost:5432/zentrust?schema=public"

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.zentrust.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/